# 本地开发：复制为 server/.env，默认无需 PostgreSQL、Redis 或真实 Incus 宿主机。
# Docker 部署使用项目根目录的 .env.example → .env。

# ───────── 数据库与缓存 ─────────
# SQLite 仅用于本地开发，pnpm db:migrate 会用 db push 建表
DATABASE_URL=file:./data/dev.db
# PostgreSQL：改为自己的连接串
# DATABASE_URL=postgresql://paledove:password@127.0.0.1:5432/paledove
# 进程内存储与任务队列，单进程使用，数据保存在 data/memory-redis.json
REDIS_URL=memory://
# 使用真实 Redis 时改为：redis://127.0.0.1:6379/0
# 应用密钥：用于加密实例 root 密码、支付密钥等数据，部署后不可更改，否则已加密的数据将无法解密
# 生成方式：openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

# ───────── 服务 ─────────
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# 面板对外访问地址：宿主机安装脚本回连与支付网关回调使用，宿主机和支付网关都需要能访问到它
# 未设置时根据当前请求的地址推断（反向代理后需同时设置 TRUST_PROXY=true）
PANEL_URL=http://127.0.0.1:5180
# 前端构建产物目录，设置后由后端直接托管页面（相对于 server）
WEB_DIST=../web/dist
# 工单附件目录（相对于 server，也可以使用绝对路径）；多 API 进程需共享此目录
UPLOAD_DIR=data/uploads
# Incus 客户端证书目录：开发者自行创建并上传 client.crt 与 client.key，系统不会自动生成或存入数据库
# 相对路径以 server 为基准；也可设置绝对路径，多 API / Worker 进程需读取同一对证书
INCUS_CERT_DIR=certs/incus

# 位于 Nginx / Caddy 等反向代理之后时设为 true，以获取真实客户端 IP
TRUST_PROXY=false
# Cookie 仅通过 HTTPS 发送；未设置时 production 环境默认 true
COOKIE_SECURE=false
# 会话有效期（小时）
SESSION_TTL_HOURS=168

# ───────── Agent 下载源 ─────────
# 正式部署填写本项目的 GitHub 仓库 owner/repo；面板查询 agent-v* Release 并代理下载，宿主机只连接面板
# 发布方法见 docs/AGENT_RELEASE.md；不可填写 Incudal 仓库，其 Agent 协议与本项目不同
AGENT_RELEASE_REPOSITORY=
# 私有仓库或需要提高 GitHub API 配额时填写，只保存在面板服务器，不会下发宿主机
AGENT_RELEASE_TOKEN=
# 可选磁盘缓存；默认使用操作系统临时目录。相对路径以 server 为基准，写入失败仍可使用内存缓存
# AGENT_RELEASE_CACHE_DIR=data/agent-release-cache
# 未配置 Release 仓库时使用本地构建，目录默认 ../agent/dist，相对路径以 server 为基准
# AGENT_DIST=../agent/dist

# ───────── 后台任务 ─────────
# 本进程是否提供 HTTP API / 是否运行任务 Worker（可拆分为两个进程，Worker 建议只运行一个）
RUN_API=true
RUN_WORKER=true
WORKER_CONCURRENCY=4
# 资源与流量采集间隔（秒）
METRICS_INTERVAL_SEC=60

# ───────── 初始化（pnpm db:seed） ─────────
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
# 设为 true 时创建模拟节点（mock://）、示例套餐与演示用户，仅用于体验
SEED_DEMO=true

# 仅运行前端热更新服务器时可设为 1，跳过缺失 web/dist 时的自动构建
# SKIP_WEB_BUILD=1
