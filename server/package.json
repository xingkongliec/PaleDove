{
  "name": "@paledove/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "pnpm run db:generate",
    "dev": "node scripts/ensure-web.mjs && tsx watch --clear-screen=false src/index.ts",
    "build": "pnpm run db:generate && node scripts/build.mjs",
    "start": "node scripts/ensure-web.mjs --server && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate && node scripts/sqlite-schema.mjs && prisma generate --config prisma.sqlite.config.ts",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:deploy": "node scripts/db.mjs deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@simplewebauthn/server": "14.0.3",
    "bullmq": "^5.81.5",
    "dayjs": "^1.11.23",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.6",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.11.1",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.1.4",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.0",
    "undici": "^7.30.1",
    "ws": "^8.18.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@types/node": "^22.19.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
