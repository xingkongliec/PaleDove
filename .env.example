# Docker 部署：复制为项目根目录的 .env；本地开发使用 server/.env.example。
# Compose 使用 raw 格式，值不要加引号；密码中的 $ 会原样保留。
# PostgreSQL、Redis 使用已有服务，此部署不会启动数据库或 Redis 容器。
NODE_ENV=production
DATABASE_URL=postgresql://paledove:replace-with-db-password@db.example.com:5432/paledove
REDIS_URL=redis://:replace-with-redis-password@redis.example.com:6379/0

# 使用 openssl rand -hex 32 生成；部署后保持不变，升级须沿用原值。
APP_SECRET=replace-with-a-random-secret
PANEL_URL=https://panel.example.com
TRUST_PROXY=true
COOKIE_SECURE=true
LOG_LEVEL=info

# 容器启动时仅在数据库中没有管理员时使用这些值创建账号。
# 已有管理员时直接跳过，修改环境变量不会覆盖账号或密码。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_DEMO=false

# 默认启动时自动执行 PostgreSQL 增量迁移；单独迁移后可设为 false。
DB_MIGRATE=true
RUN_API=true
RUN_WORKER=true
WORKER_CONCURRENCY=4
METRICS_INTERVAL_SEC=60
SESSION_TTL_HOURS=168

# 正式 Agent 下载源填写本项目的 GitHub 仓库，详见 docs/AGENT_RELEASE.md。
AGENT_RELEASE_REPOSITORY=
AGENT_RELEASE_TOKEN=

# 宿主机映射地址和端口（由 Compose 读取）
PANEL_BIND=127.0.0.1
PANEL_PORT=3000
